  <rdf:Description rdf:about="http://purl.org/spar/pro/RoleInTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="ne64009a37071456a9cda154ced4672f2b7"/>
    <rdfs:subClassOf rdf:nodeID="ne64009a37071456a9cda154ced4672f2b1"/>
